PORT=3000
LOG_LEVEL=info

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=/absolute/path/to/private.key
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_URL=https://demo.docusign.net
DOCUSIGN_ALLOWED_SENDERS=hr@capital-infusion.com
# Exact signer emails to exclude from representative identity resolution.
# Keep this separate from DOCUSIGN_ALLOWED_SENDERS; domains are not excluded.
DOCUSIGN_INTERNAL_SIGNERS=hr@capital-infusion.com,submissions@capital-infusion.com

# Set this to the Connect configuration's HMAC key (not the RSA private key).
DOCUSIGN_CONNECT_HMAC_SECRET=
DOCUSIGN_REQUIRE_HMAC=true

DOCUSIGN_STORAGE_DIR=./data/docusign
DOCUSIGN_MAX_WEBHOOK_BYTES=1048576

# Cloudflare R2. Leave all five empty to use local filesystem storage.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Contract renewal reminders (used by `npm run contract-reminders`).
CONTRACT_NOTIFICATION_EMAIL=gustavo@capital-infusion.com
CONTRACT_EMAIL_PROVIDER=power-automate
CONTRACT_POWER_AUTOMATE_URL=

# Optional Resend fallback. These are not required for power-automate.
CONTRACT_EMAIL_FROM=
RESEND_API_KEY=
